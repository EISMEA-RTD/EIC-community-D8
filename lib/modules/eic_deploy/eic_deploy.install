<?php

/**
 * @file
 * Install, update and uninstall functions for the EIC Deploy module.
 */

use Drupal\Core\Url;
use Drupal\block_content\Entity\BlockContent;
use Drupal\taxonomy\Entity\Term;
use Drupal\user\Entity\Role;

/**
 * Clears the registration of a module whose code is no longer on disk.
 *
 * A module listed in core.extension but absent from disk reports
 * moduleExists() === FALSE, so a hook that asks that question first concludes
 * "already uninstalled" and leaves the registration in place. That is exactly
 * backwards, and it matters: ModuleInstaller validates the whole module list,
 * so group_update_9200 -- which installs flexible_permissions -- fails with
 * "The module X does not exist" while even one such entry survives.
 *
 * @param string $module
 *   The module to check.
 *
 * @return bool
 *   TRUE if a stale registration was cleared, in which case the caller has
 *   nothing further to do for this module.
 */
function _eic_deploy_clear_missing_module_registration(string $module): bool {
  $extension = \Drupal::configFactory()->getEditable('core.extension');
  $modules = $extension->get('module') ?: [];

  // Not registered at all: genuinely nothing to do.
  if (!array_key_exists($module, $modules)) {
    return FALSE;
  }
  // Registered and present: let the caller uninstall it properly.
  if (\Drupal::service('extension.list.module')->exists($module)) {
    return FALSE;
  }

  unset($modules[$module]);
  $extension->set('module', $modules)->save();
  \Drupal::service('update.update_hook_registry')->deleteInstalledVersion($module);

  // A real uninstall also deletes the module's own configuration. Clearing the
  // registration by hand does not, and the leftovers then block the config
  // import at the end of the deploy: "Configuration X depends on the Y
  // extension that will not be installed after import."
  $config_factory = \Drupal::configFactory();
  $deleted = [];
  foreach ($config_factory->listAll($module . '.') as $name) {
    $config_factory->getEditable($name)->delete();
    $deleted[] = $name;
  }

  \Drupal::messenger()->addMessage($deleted
    ? t('Cleared the stale registration of "@module", which has no code on disk, and deleted @count config object(s) it owned.', [
      '@module' => $module,
      '@count' => count($deleted),
    ])
    : t('Cleared the stale registration of "@module", which has no code on disk.', [
      '@module' => $module,
    ]));
  return TRUE;
}

/**
 * Implements hook_update_dependencies().
 */
function eic_deploy_update_dependencies() {
  // Drupal orders updates by module and by number independently, which is not
  // enough here: this module's hooks and Group's have to interleave in a
  // specific way. The rehearsal against the TEST database proved it.
  //
  // group_update_9200 installs flexible_permissions, and ModuleInstaller
  // validates the whole module list while doing so. Any module still
  // registered in core.extension whose code has been removed makes that fail
  // -- on TEST it failed with "The module block_content_permissions does not
  // exist". Hooks 9014 to 9019 are what clear those registrations, so they all
  // have to run first.
  $dependencies['group'][9200]['eic_deploy'] = 9019;

  // eic_deploy_update_9020 deletes relation types through the entity API, so
  // group_content_type has to be loadable. Until group_update_9201 and _9202
  // have rewritten the stored entity classes, the entity type still names
  // Drupal\group\Entity\GroupContentType, which Group 2 does not ship, and
  // the hook dies on an assertion instead.
  $dependencies['eic_deploy'][9020]['group'] = 9202;

  // These two write group role permissions. group_update_9205 to _9208 rewrite
  // every group role, converting audience to scope, so let that settle first.
  $dependencies['eic_deploy'][9022]['group'] = 9208;
  $dependencies['eic_deploy'][9023]['group'] = 9208;

  // These two touch relationship fields and membership entities, so they need
  // the whole Group 2 chain -- in particular group_update_9203, which renames
  // the base and data tables.
  $dependencies['eic_deploy'][9021]['group'] = 9211;
  $dependencies['eic_deploy'][9025]['group'] = 9211;

  // 9026 repairs views and the search index after group_update_9203 renames the
  // relationship tables. It has to run after that rename and, being a
  // hook_update_N, it is guaranteed to run before any post-update -- which is
  // the point, because core's views post-updates are what trip over the stale
  // references.
  $dependencies['eic_deploy'][9026]['group'] = 9211;

  // 9027 edits the stored definitions of the group entity type. Group's own
  // updates rewrite those, so let the whole chain finish before touching them.
  $dependencies['eic_deploy'][9027]['group'] = 9211;

  return $dependencies;
}

/**
 * Implements hook_install().
 */
function eic_deploy_install() {
  // Check the install profile. We need to be on minimal, not oe_profile.
  $oldProfile = 'oe_profile';
  $newProfile = 'minimal';

  $extensionConfig = \Drupal::configFactory()->getEditable('core.extension');
  $currentProfile = $extensionConfig->get('profile');

  if ($currentProfile === $newProfile) {
    // When the current profile already matches the new profile, bail out.
    \Drupal::messenger()->addStatus(t('Profile already is Minimal.'));
    return;
  }
  \Drupal::keyValue('system.schema')->delete($oldProfile);
  \Drupal::keyValue('system.schema')->set($newProfile, 8000);

  $modules = $extensionConfig->get('module');
  $modules[$newProfile] = 1000;
  unset($modules[$oldProfile]);
  $extensionConfig->set('module', $modules);
  $extensionConfig->set('profile', $newProfile);
  $extensionConfig->save();
  drupal_flush_all_caches();

  \Drupal::messenger()->addStatus(t('Profile was switched from OE Profile to Minimal.'));
}

/**
 * Implements hook_uninstall().
 */
function eic_deploy_uninstall() {
  \Drupal::messenger()->addStatus(__FUNCTION__);
}

/**
 * Implements hook_requirements().
 */
function eic_deploy_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $value = mt_rand(0, 100);
    $requirements['eic_deploy_status'] = [
      'title' => t('EIC Deploy status'),
      'value' => t('EIC Deploy value: @value', ['@value' => $value]),
      'severity' => $value > 50 ? REQUIREMENT_INFO : REQUIREMENT_WARNING,
    ];
  }

  return $requirements;
}

/**
 * Re-create moderation states for existing entities.
 */
function eic_deploy_update_9001(&$sandbox) {
  $wiki_workflows = \Drupal::entityTypeManager()
    ->getStorage('content_moderation_state')
    ->loadByProperties([
      'workflow' => 'group_wiki',
    ]);
  // Re-create wiki page workflows.
  foreach ($wiki_workflows as $wiki_workflow) {
    $state = $wiki_workflow->get('moderation_state')->value;
    $entity_id = $wiki_workflow->get('content_entity_id')->value;
    $wiki_workflow->delete();
    $entity = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->load($entity_id);
    $entity->set('moderation_state', $state);
    $entity->save();
  }
}


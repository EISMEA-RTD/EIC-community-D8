# Ignore Composer dependencies.
/vendor/
/docs/
# Ignore files generated by IDEs.
/.idea/

# Ignore web and dist folder.
/web/
!/web/sites/default/default.settings.*.php
/dist/

/private_files
!/private_files/.gitkeep

# Local private files stream (settings.local.php: file_private_path = ../private).
/private

# Ignore files generated by installation script.
/config/sync/.htaccess

# Ignore local configuration files.
/behat.yml
/runner.yml
/docker-compose.*.yml
/.gitattributes
.env
**/.DS_Store

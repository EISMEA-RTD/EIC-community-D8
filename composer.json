        "drupal/menu_trail_by_path": "^2.1",
        "drupal/message": "^1.2",
        "drupal/message_notify": "^1.2",
        "drupal/message_subscribe": "^2.1",
        "drupal/metatag": "^2.2",
        "drupal/mimemail": "^2.0",
        "drupal/node_read_time": "^1.3",
        "drupal/openapi": "^2.0@RC",
        "drupal/openapi_rest": "^2.0@RC",
        "drupal/paragraph_view_mode": "^3.2",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/profile": "^1.2",
        "drupal/publication_date": "^3.1",
        "drupal/queue_ui": "^3.2",
        "drupal/rabbit_hole": "^1.0",
        "drupal/raven": "^5.0",
        "drupal/realname": "^2.0-@beta",
        "drupal/redirect": "^1.6",
        "drupal/redis": "^1.5",
        "drupal/require_on_publish": "^2.0",
        "drupal/restui": "^1.19",
        "drupal/role_delegation": "^1.2",
        "drupal/route_condition": "^2.0",
        "drupal/scheduler": "^2.0",
        "drupal/scheduler_content_moderation_integration": "^3.0",
        "drupal/search_api_attachments": "^10.0.5",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_sorts": "^1.1",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/select2": "^2.0",
        "drupal/smart_trim": "^2.0",
        "drupal/smtp": "^1.4",
        "drupal/social_link_field": "^2.1",
        "drupal/stable": "^2.1",
        "drupal/statistics": "^1.0",
        "drupal/subpathauto": "^1.1",
        "drupal/twig_field_value": "^2.0",
        "drupal/typed_link": "^2.0",
        "drupal/ui_patterns": "^1.2",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_bulk_operations": "4.2.7",
        "drupal/views_data_export": "1.5.0",
        "drupal/views_data_export_phpspreadsheet": "^2.0",
        "drupal/views_fields_on_off": "^2.0",
        "drupal/workflow_buttons": "^1.0@beta",
        "drush/drush": "^13",
        "mglaman/composer-drupal-lenient": "^1.0",
        "mottie/tablesorter": "^2.32",
        "openeuropa/composer-artifacts": "^1.0@alpha",
        "openeuropa/ecl-twig-loader": "^4.0",
        "openeuropa/oe_authentication": "^1.13",
        "openeuropa/oe_content": "~4.8.0",
        "openeuropa/oe_corporate_blocks": "^5.0",
        "openeuropa/oe_media": "^1.13",
        "openeuropa/oe_paragraphs": "^1.32",
        "openeuropa/oe_theme": "5.0.0",
        "openeuropa/oe_time_caching": "^1.1",
        "openeuropa/oe_webtools": "^1.26.0",
        "select2/select2": "^4.0",
        "softcreatr/jsonpath": "0.8",
        "webmozart/path-util": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "require-dev": {
        "drevops/behat-screenshot": "^1.2",
        "drupal/cas_mock_server": "^2.0.1",
        "drupal/core-dev": "^11.4",
        "drupal/data_fixtures": "^1.8",
        "drupal/devel": "^5.1",
        "drupal/drupal-extension": "^6.1",
        "drupal/upgrade_status": "^4.3",
        "mglaman/phpstan-drupal": "^1.3",
        "palantirnet/drupal-rector": "^0.20.3",
        "phpspec/prophecy-phpunit": "^2",
        "rdx/behat-variables": "^1.2"
    },
    "conflict": {
        "twig/twig": "3.30.0"
    },
    "scripts": {
        "post-install-cmd": [
            "DrupalComposer\\DrupalScaffold\\Plugin::scaffold"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "extra": {
        "merge-plugin": {
            "require": [
                "composer.libraries.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": true,
            "merge-scripts": true
        },
        "artifacts": {
            "openeuropa/oe_theme": {
                "dist": {
                    "url": "https://github.com/{name}/releases/download/{pretty-version}/{project-name}-{pretty-version}.zip",
                    "type": "zip"
                }
            }
        },
        "composer-exit-on-patch-failure": true,
        "composer-patches": {
            "patches-file": "composer.patches.json",
            "ignore-dependency-patches": [
                "openeuropa/oe_content",
                "openeuropa/oe_paragraphs"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/libraries/ckeditor/plugins/{$name}": [
                "type:ckeditor-plugin"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "autoload-dev": {
            "psr-4": {
                "OpenEuropa\\Site\\Tests\\": "./tests/",
                "Drupal\\Tests\\oe_media\\": "./web/modules/contrib/oe_media/tests/src/"
            }
        },
        "conflict": {
            "drupal/drupal": "*"
        },
        "config": {
            "sort-packages": true,
            "allow-plugins": {
                "composer/installers": true,
                "cweagans/composer-patches": true,
                "dealerdirect/phpcodesniffer-composer-installer": true,
                "drupal/core-composer-scaffold": true,
                "mglaman/composer-drupal-lenient": true,
                "php-http/discovery": true,
                "phpstan/extension-installer": true,
                "tbachert/spi": true,
                "wikimedia/composer-merge-plugin": true
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/aws_sqs"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "mglaman/composer-drupal-lenient": true,
            "openeuropa/composer-artifacts": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    }
}
